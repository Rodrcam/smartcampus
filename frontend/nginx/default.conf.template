# Plantilla de nginx. Al arrancar el contenedor, la imagen oficial sustituye las
# variables ${...} con los valores de las variables de entorno y guarda el
# resultado en /etc/nginx/conf.d/default.conf.
#   BACKEND_URL            -> dirección del backend (Compose o Service de Kubernetes)
#   APP_ENV                -> entorno que se muestra en la interfaz
#   NGINX_LOCAL_RESOLVERS  -> servidor DNS del contenedor (Docker o Kubernetes)

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolver el nombre del backend en cada petición (con caché de 10 s) y no
    # solo al arrancar: si el backend se recrea con otra IP, nginx la encuentra.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Configuración que lee el JavaScript del navegador.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"appEnv": "${APP_ENV}", "backendUrl": "${BACKEND_URL}"}';
    }

    # Proxy inverso: el navegador llama a /api/... y nginx reenvía la petición
    # al backend quitando el prefijo /api.
    location /api/ {
        set $backend ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
}
